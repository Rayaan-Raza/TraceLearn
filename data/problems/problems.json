      "function_name": "sum_first_n",
      "concept_tags": [
        "loops",
        "boundaries"
      ],
      "prerequisite_tags": [
        "variables"
      ],
      "starter_code": "def sum_first_n(n):\n    pass\n",
      "designed_misconception": "M01_LOOP_BOUNDARY",
      "test_cases": [
        {
          "id": "P01-V1",
          "name": "visible n=5",
          "test_type": "visible",
          "input_json": {
            "args": [
              5
            ]
          },
          "expected_output_json": 10,
          "sort_order": 1
        },
        {
          "id": "P01-V2",
          "name": "visible n=0",
          "test_type": "visible",
          "input_json": {
            "args": [
              0
            ]
          },
          "expected_output_json": 0,
          "sort_order": 2
        },
        {
          "id": "P01-H1",
          "name": "hidden n=1",
          "test_type": "hidden",
          "input_json": {
            "args": [
              1
            ]
          },
          "expected_output_json": 0,
          "sort_order": 3
        },
        {
          "id": "P01-H2",
          "name": "hidden n=10",
          "test_type": "hidden",
          "input_json": {
            "args": [
              10
            ]
          },
          "expected_output_json": 45,
          "sort_order": 4
        },
        {
          "id": "P01-D1",
          "name": "diagnostic upper boundary",
          "test_type": "diagnostic",
          "input_json": {
            "args": [
              0
            ]
          },
          "expected_output_json": 0,
          "diagnostic_tag": "upper_boundary",
          "sort_order": 5
        },
        {
          "id": "P01-D2",
          "name": "diagnostic n=1",
          "test_type": "diagnostic",
          "input_json": {
            "args": [
              1
            ]
          },
          "expected_output_json": 0,
          "diagnostic_tag": "upper_boundary",
          "sort_order": 6
        }
      ]
