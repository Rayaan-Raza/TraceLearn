# Line-ending policy for the TraceLearn repository.
#
# The C++ diagnostic test bank is judged by token comparison, but the
# normalization rule still applies: every test file must use Unix LF
# endings and must carry no trailing whitespace. Git must not rewrite
# those files on checkout, so they are pinned to LF here. This also
# protects the bank on machines where `core.autocrlf` is set to `true`.

# This file keeps Unix endings too.
.gitattributes  text eol=lf

# C++ diagnostic bank: problems, tests, reference solutions and variants.
data/cpp_problems/**/*.in    text eol=lf
data/cpp_problems/**/*.out   text eol=lf
data/cpp_problems/**/*.json  text eol=lf
data/cpp_problems/**/*.cpp   text eol=lf
data/cpp_problems/**/*.md    text eol=lf

# Python and shell sources keep their committed endings.
*.py    text eol=lf
*.sh    text eol=lf

# Docker build files must stay Unix-style: a CRLF Dockerfile breaks the
# Linux build that Railway runs.
Dockerfile    text eol=lf
.dockerignore text eol=lf

# Binary and lock artefacts are never rewritten.
*.png   binary
*.jpg   binary
*.ico   binary
*.db    binary
