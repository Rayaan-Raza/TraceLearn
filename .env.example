# TraceLearn environment. Copy to .env and adjust.

# development | production. Production enforces every check below at startup.
APP_ENV=development

# REQUIRED in production: random, >= 32 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# Teachers can read student work, so the role cannot be self-assigned.
# Leave empty to disable teacher self-signup (use scripts/create_teacher.py),
# or set a long secret code you hand to teachers.
TEACHER_SIGNUP_CODE=

DATABASE_URL=sqlite:///./tracelearn.db
EVIDENCE_WEIGHTS_PATH=./config/evidence_weights.yaml

# Browser origins allowed to call the API with credentials (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Cookies: Secure defaults to true in production. Use SameSite=none only for
# cross-site deployments (then COOKIE_SECURE must be true).
# COOKIE_SECURE=
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Serve frontend/dist from the backend (same-origin; recommended for deploys).
SERVE_FRONTEND=false
# Swagger at /docs. Defaults to on in development, off in production.
# ENABLE_DOCS=

# Research demo endpoints (/api/demo/*). Never enable in production.
ENABLE_DEMO_ENDPOINTS=false

# --- Code execution sandbox ---------------------------------------------
# Student code runs in bubblewrap (apt install bubblewrap): no network,
# no host files, empty environment, CPU/memory/output limits.
# auto = use bubblewrap if present; bwrap = require it; none = limits only.
SANDBOX_MODE=auto
# Refuse to execute without bubblewrap. Defaults to true in production.
# REQUIRE_SANDBOX=
EXECUTION_TIMEOUT_SECONDS=5
COMPILE_TIMEOUT_SECONDS=30
MAX_SOURCE_BYTES=65536
MAX_MEMORY_MB=256
MAX_CONCURRENT_EXECUTIONS=4

# --- Rate limits (per process) -------------------------------------------
LOGIN_ATTEMPTS_PER_MINUTE=10
REGISTER_ATTEMPTS_PER_HOUR=20
EXECUTIONS_PER_MINUTE=12
